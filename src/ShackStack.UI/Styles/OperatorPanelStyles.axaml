<Styles xmlns="https://github.com/avaloniaui">
  <Style Selector="TextBlock.sectionTitle">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="#E8E8EA" />
  </Style>

  <Style Selector="TextBlock.fieldLabel">
    <Setter Property="Foreground" Value="#8E9096" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.fieldValue">
    <Setter Property="Foreground" Value="#D8D8DC" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="#0B0C0F" />
    <Setter Property="BorderBrush" Value="#202126" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="10" />
  </Style>

  <Style Selector="Border.section">
    <Setter Property="Background" Value="#08090C" />
    <Setter Property="BorderBrush" Value="#1B1C21" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="Padding" Value="0,2,0,4" />
  </Style>

  <Style Selector="Window.operatorDesk Button">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="#181A1F" />
    <Setter Property="BorderBrush" Value="#2B2D34" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="#F0F3FA" />
  </Style>

  <Style Selector="Window.operatorDesk NumericUpDown">
    <Setter Property="Height" Value="30" />
    <Setter Property="Background" Value="#050608" />
    <Setter Property="BorderBrush" Value="#2D2F36" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="#F4F7FC" />
  </Style>

  <Style Selector="Window.operatorDesk TextBox">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Background" Value="#030405" />
    <Setter Property="BorderBrush" Value="#292B31" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Foreground" Value="#F4F7FC" />
  </Style>

  <Style Selector="Window.operatorDesk Expander">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Window.operatorDesk TextBox.monospace">
    <Setter Property="FontFamily" Value="Consolas" />
  </Style>
</Styles>
