<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ShackStack.UI.ViewModels"
        xmlns:controls="using:ShackStack.UI.Controls"
        x:Class="ShackStack.UI.Views.KeyboardModesDeskWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1440"
        Height="960"
        MinWidth="1180"
        MinHeight="800"
        Title="Keyboard Modes Desk"
        Icon="avares://ShackStack.Desktop/Assets/shackstack.ico"
        Background="#050607"
        Foreground="#D8D8DC"
        Classes="operatorDesk">
  <controls:OperatingWorkspace Desk="Keyboard">
  <Grid RowDefinitions="Auto,*" Margin="0">
    <Border Grid.Row="0" Classes="panel" Padding="10,8" Margin="0,0,0,8">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock Text="Keyboard Modes Desk" Classes="sectionTitle" />
          <TextBlock Text="PSK31/63 receive using the fldigi-derived GPL chain. Olivia, Contestia, and MFSK can join this desk next."
                     Foreground="#A8A8AE"
                     TextWrapping="Wrap" />
        </StackPanel>
        <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Start RX" Command="{Binding StartKeyboardReceiveCommand}" Margin="0,0,8,0" />
          <Button Content="Stop RX" Command="{Binding StopKeyboardReceiveCommand}" Margin="0,0,8,0" />
          <Button Content="Reset" Command="{Binding ResetKeyboardSessionCommand}" />
        </WrapPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="360,*" ColumnSpacing="8">
      <Border Grid.Column="0" Classes="panel" Padding="10">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="8">
            <TextBlock Text="Receive Setup" Classes="sectionTitle" />
            <TextBlock Text="Use USB-D/LSB-D and tune the PSK trace near the selected audio center. AFC will show the small correction it is tracking."
                       Foreground="#A8A8AE"
                       TextWrapping="Wrap" />
            <CheckBox Content="Use tuned frequency" IsChecked="{Binding KeyboardUseCurrentRadioFrequency}" />
            <Grid ColumnDefinitions="92,*" ColumnSpacing="8">
              <TextBlock Grid.Column="0" Text="Mode" Foreground="#8E9096" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding KeyboardModeOptions}" SelectedItem="{Binding KeyboardSelectedMode}" />
            </Grid>
            <Grid ColumnDefinitions="92,*" ColumnSpacing="8">
              <TextBlock Grid.Column="0" Text="Tune" Foreground="#8E9096" VerticalAlignment="Center" />
              <AutoCompleteBox Grid.Column="1"
                               ItemsSource="{Binding KeyboardFrequencyOptions}"
                               Text="{Binding KeyboardSelectedFrequency}"
                               FilterMode="Contains"
                               MinimumPrefixLength="0" />
            </Grid>
            <Grid ColumnDefinitions="92,*" ColumnSpacing="8">
              <TextBlock Grid.Column="0" Text="Audio Hz" Foreground="#8E9096" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Text="{Binding KeyboardAudioCenterHz}" />
            </Grid>
            <Border Background="#08090C" BorderBrush="#1B1C21" BorderThickness="1" CornerRadius="3" Padding="8">
              <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                <TextBlock Grid.Row="0" Text="{Binding KeyboardTuneHelperSuggestion}" Foreground="#D8D8DC" TextWrapping="Wrap" />
                <Button Grid.Row="1" Content="Apply Tune Helper" Command="{Binding ApplyKeyboardTuneHelperCommand}" HorizontalAlignment="Left" />
              </Grid>
            </Border>
            <CheckBox Content="Reverse BPSK polarity" IsChecked="{Binding KeyboardReversePolarity}" />
            <Border Background="#08090C" BorderBrush="#1B1C21" BorderThickness="1" CornerRadius="3" Padding="10">
              <StackPanel Spacing="8">
                <TextBlock Text="Status" Classes="sectionTitle" />
                <Grid ColumnDefinitions="92,*" ColumnSpacing="8">
                  <TextBlock Grid.Column="0" Text="RX" Foreground="#8E9096" />
                  <TextBlock Grid.Column="1" Text="{Binding KeyboardRxStatus}" Foreground="#D8D8DC" TextWrapping="Wrap" />
                </Grid>
                <Grid ColumnDefinitions="92,*" ColumnSpacing="8">
                  <TextBlock Grid.Column="0" Text="Session" Foreground="#8E9096" />
                  <TextBlock Grid.Column="1" Text="{Binding KeyboardSessionNotes}" Foreground="#D8D8DC" TextWrapping="Wrap" FontFamily="Consolas" />
                </Grid>
              </StackPanel>
            </Border>
            <Border Background="#08090C" BorderBrush="#1B1C21" BorderThickness="1" CornerRadius="3" Padding="10">
              <StackPanel Spacing="8">
                <TextBlock Text="Keyboard / Longwave Log" Classes="sectionTitle" />
                <TextBlock Text="{Binding LongwaveLogStatus}" Foreground="#A8A8AE" TextWrapping="Wrap" />
                <TextBlock Text="{Binding LongwaveQuickLogSummary}" Foreground="#E8E8EA" FontWeight="SemiBold" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="74,*" ColumnSpacing="8">
                  <TextBlock Grid.Column="0" Text="Logbook" Foreground="#8E9096" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding LongwaveLogbooks}" SelectedItem="{Binding SelectedLongwaveLogbook}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:LongwaveLogbookItem">
                        <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
                <Grid ColumnDefinitions="74,*" ColumnSpacing="8">
                  <TextBlock Grid.Column="0" Text="Call" Foreground="#8E9096" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding LongwaveLogCallsign}" Watermark="Worked station" />
                </Grid>
                <Grid ColumnDefinitions="74,*,*" ColumnSpacing="8">
                  <TextBlock Grid.Column="0" Text="RST S/R" Foreground="#8E9096" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding LongwaveLogRstSent}" />
                  <TextBox Grid.Column="2" Text="{Binding LongwaveLogRstReceived}" />
                </Grid>
                <WrapPanel Orientation="Horizontal">
                  <Button Content="Use Rig" Command="{Binding UseRigForKeyboardLongwaveLogCommand}" Margin="0,0,8,6" />
                  <Button Content="Log QSO" Command="{Binding LogCurrentQsoCommand}" IsVisible="{Binding IsCreatingLongwaveContact}" Margin="0,0,8,6" />
                  <Button Content="Save" Command="{Binding UpdateSelectedLongwaveContactCommand}" IsVisible="{Binding IsEditingLongwaveContact}" Margin="0,0,8,6" />
                  <Button Content="New" Command="{Binding NewLongwaveContactCommand}" Margin="0,0,8,6" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Border Grid.Column="1" Classes="panel" Padding="10">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <TextBlock Text="Decoded Text" Classes="sectionTitle" />
            <Button Grid.Column="1" Content="Clear" Command="{Binding ClearKeyboardDecodedTextCommand}" />
          </Grid>
          <TextBox Grid.Row="1"
                   Text="{Binding KeyboardDecodedText}"
                   AcceptsReturn="True"
                   IsReadOnly="True"
                   TextWrapping="Wrap"
                   FontSize="15" />
          <Border Grid.Row="2" Background="#08090C" BorderBrush="#1B1C21" BorderThickness="1" CornerRadius="3" Padding="10">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
              <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <StackPanel Spacing="4">
                  <TextBlock Text="Transmit Prep" Classes="sectionTitle" />
                  <TextBlock Text="Build a fldigi-style BPSK31/63 WAV first, then send the prepared audio through the normal radio/PTT path."
                             Foreground="#A8A8AE"
                             TextWrapping="Wrap" />
                </StackPanel>
                <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="Prepare TX WAV" Command="{Binding PrepareKeyboardTransmitCommand}" Margin="0,0,8,0" />
                  <Button Content="Send Prepared" Command="{Binding SendKeyboardTransmitCommand}" />
                </WrapPanel>
              </Grid>
              <TextBox Grid.Row="1"
                       Text="{Binding KeyboardTransmitText}"
                       AcceptsReturn="True"
                       MinHeight="70"
                       TextWrapping="Wrap"
                       FontSize="15" />
              <Grid Grid.Row="2" RowDefinitions="Auto,Auto" RowSpacing="4">
                <TextBlock Grid.Row="0" Text="{Binding KeyboardPreparedTransmitStatus}" Foreground="#D8D8DC" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Text="{Binding KeyboardPreparedTransmitPath}" Foreground="#8E9096" TextWrapping="Wrap" />
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
  </controls:OperatingWorkspace>
</Window>
