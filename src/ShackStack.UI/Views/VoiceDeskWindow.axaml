<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ShackStack.UI.ViewModels"
        xmlns:controls="using:ShackStack.UI.Controls"
        xmlns:models="using:ShackStack.Core.Abstractions.Models"
        x:Class="ShackStack.UI.Views.VoiceDeskWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1440"
        Height="960"
        MinWidth="1180"
        MinHeight="800"
        Title="Voice Desk"
        Icon="avares://ShackStack.Desktop/Assets/shackstack.ico"
        Background="#050607"
        Foreground="#D8D8DC"
        Classes="operatorDesk">
  <controls:OperatingWorkspace Desk="Voice">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Text="Voice / POTA" Classes="sectionTitle" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding VoiceTxStatus}" Foreground="#A8A8AE" TextWrapping="Wrap" MaxWidth="440" VerticalAlignment="Center" />
      </Grid>
      <Grid Grid.Row="1" ColumnDefinitions="1.65*,1*" ColumnSpacing="16">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
          <Grid ColumnDefinitions="*,150,Auto" ColumnSpacing="8">
            <TextBlock Text="POTA Activity" Classes="sectionTitle" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding VoiceLongwaveBandFilterOptions}" SelectedItem="{Binding SelectedVoiceLongwaveBandFilter}" HorizontalAlignment="Stretch" />
            <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshLongwaveSpotsCommand}" />
          </Grid>
          <TextBlock Grid.Row="1" Text="{Binding LongwaveStatus}" Foreground="#A8A8AE" TextWrapping="Wrap" FontSize="12" />
          <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="6">
            <Grid ColumnDefinitions="64,100,100,*" Margin="10,0" ColumnSpacing="8">
              <TextBlock Text="Band" Classes="fieldLabel" />
              <TextBlock Grid.Column="1" Text="Frequency" Classes="fieldLabel" />
              <TextBlock Grid.Column="2" Text="Callsign" Classes="fieldLabel" />
              <TextBlock Grid.Column="3" Text="Park / Activity" Classes="fieldLabel" />
            </Grid>
            <ListBox Grid.Row="1" ItemsSource="{Binding VoiceLongwavePotaSpots}" SelectedItem="{Binding SelectedVoiceLongwavePotaSpot}" Background="#030405" BorderThickness="1" BorderBrush="#202126">
              <ListBox.Styles>
                <Style Selector="ListBoxItem"><Setter Property="Padding" Value="8,7" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:LongwaveSpotSummaryItem">
                  <Grid ColumnDefinitions="64,100,100,*" ColumnSpacing="8">
                    <TextBlock Text="{Binding Band}" Foreground="#A8A8AE" FontSize="12" />
                    <TextBlock Grid.Column="1" Text="{Binding FrequencyText}" Foreground="#D8D8DC" FontSize="12" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding ActivatorCallsign}" Foreground="{Binding MessageForeground}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="3" Text="{Binding SummaryText}" Foreground="{Binding MessageForeground}" FontSize="12" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
          <StackPanel Grid.Row="3" Spacing="8">
            <WrapPanel>
              <Button Content="Work Selected Spot" Command="{Binding WorkSelectedVoiceLongwaveSpotCommand}" Margin="0,0,8,4" />
              <Button Content="Use Rig for Contact" Command="{Binding UseRigForLongwaveLogCommand}" Margin="0,0,0,4" />
            </WrapPanel>
            <Expander Header="Post a spot" HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                  <StackPanel Spacing="4"><TextBlock Text="Activator callsign" Classes="fieldLabel" /><TextBox Text="{Binding VoicePotaSpotCallsign}" /></StackPanel>
                  <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Park reference" Classes="fieldLabel" /><TextBox Text="{Binding VoicePotaSpotParkReference}" /></StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,110" ColumnSpacing="8">
                  <StackPanel Spacing="4"><TextBlock Text="Frequency (kHz)" Classes="fieldLabel" /><TextBox Text="{Binding VoicePotaSpotFrequencyKhz}" /></StackPanel>
                  <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Mode" Classes="fieldLabel" /><TextBox Text="{Binding VoicePotaSpotMode}" /></StackPanel>
                </Grid>
                <TextBox Text="{Binding VoicePotaSpotComment}" Watermark="Comment" />
                <WrapPanel><Button Content="Use Rig" Command="{Binding UseRigForVoicePotaSpotCommand}" Margin="0,0,8,0" /><Button Content="Post Spot" Command="{Binding PostVoicePotaSpotCommand}" /></WrapPanel>
              </StackPanel>
            </Expander>
          </StackPanel>
        </Grid>
        <Border Grid.Column="1" BorderBrush="#202126" BorderThickness="1,0,0,0" Padding="16,0,0,0">
          <controls:ContactLogPanel UseRigCommand="{Binding UseRigForLongwaveLogCommand}" />
        </Border>
      </Grid>
      <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" Background="#0B0C0F" Margin="0,4,0,0">
        <Border Background="#181A1F" BorderBrush="#3C3E45" BorderThickness="1" CornerRadius="4" Padding="24,12" MinWidth="160" VerticalAlignment="Center"
                Focusable="False" PointerPressed="OnPttPressed" PointerReleased="OnPttReleased" PointerCaptureLost="OnPttCaptureLost">
          <TextBlock Text="{Binding PttState, StringFormat=Push to Talk ({0})}" FontWeight="SemiBold" HorizontalAlignment="Center" />
        </Border>
        <Grid Grid.Column="1" ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
          <TextBlock Text="RX" Classes="fieldLabel" />
          <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding RxLevelPercent}" Height="6" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="Mic" Classes="fieldLabel" />
          <ProgressBar Grid.Column="3" Minimum="0" Maximum="100" Value="{Binding MicLevelPercent}" Height="6" VerticalAlignment="Center" />
        </Grid>
        <Button Grid.Column="2" Content="Mic / Power" VerticalAlignment="Center" MinWidth="130">
          <Button.Flyout>
          <Flyout Placement="Top">
          <Grid Width="280" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
            <TextBlock Text="Mic gain" Classes="fieldLabel" /><NumericUpDown Grid.Column="1" Value="{Binding VoiceMicGainPercent}" Minimum="0" Maximum="100" FormatString="F0" />
            <TextBlock Grid.Row="1" Text="Compression" Classes="fieldLabel" /><NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding VoiceCompressionPercent}" Minimum="0" Maximum="10" FormatString="F0" />
            <TextBlock Grid.Row="2" Text="RF power (%)" Classes="fieldLabel" /><NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding VoiceRfPowerPercent}" Minimum="0" Maximum="100" FormatString="F0" />
            <Button Grid.Row="3" Grid.ColumnSpan="2" Content="Apply Rig Settings" Command="{Binding ApplyVoiceRigSettingsCommand}" />
          </Grid>
          </Flyout>
          </Button.Flyout>
        </Button>
      </Grid>
    </Grid>
  </controls:OperatingWorkspace>
</Window>
