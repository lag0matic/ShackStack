<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ShackStack.UI.ViewModels"
        xmlns:controls="using:ShackStack.UI.Controls"
        x:Class="ShackStack.UI.Views.CwDeskWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1440"
        Height="960"
        MinWidth="1180"
        MinHeight="800"
        Title="CW Desk"
        Icon="avares://ShackStack.Desktop/Assets/shackstack.ico"
        Background="#050607"
        Foreground="#D8D8DC"
        Classes="operatorDesk">

  <controls:OperatingWorkspace Desk="CW">
    <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="10">
      <WrapPanel>
        <TextBlock Text="CW" Classes="sectionTitle" VerticalAlignment="Center" Margin="0,0,16,0" />
        <Button Content="Start RX" Command="{Binding StartCwDecoderCommand}" Margin="0,0,6,4" />
        <Button Content="Stop RX" Command="{Binding StopCwDecoderCommand}" Margin="0,0,6,4" />
        <Button Content="Reset" Command="{Binding ResetCwDecoderCommand}" Margin="0,0,16,4" />
        <TextBlock Text="Pitch" Classes="fieldLabel" Margin="0,0,6,4" />
        <NumericUpDown Value="{Binding CwPitchHz}" Minimum="300" Maximum="900" Increment="10" FormatString="F0" Width="138" Margin="0,0,12,4" />
        <TextBlock Text="WPM" Classes="fieldLabel" Margin="0,0,6,4" />
        <NumericUpDown Value="{Binding CwWpm}" Minimum="6" Maximum="48" FormatString="F0" Width="130" Margin="0,0,8,4" />
        <Button Content="Apply Rig Settings" Command="{Binding ApplyCwRigSettingsCommand}" Margin="0,0,0,4" />
      </WrapPanel>
      <Grid Grid.Row="1" ColumnDefinitions="1.65*,1*" ColumnSpacing="16">
        <Grid RowDefinitions="Auto,*" RowSpacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
              <TextBlock Text="Decoded Copy" Classes="sectionTitle" />
              <TextBlock Text="{Binding CwDecoderStatus}" Foreground="#A8A8AE" TextWrapping="Wrap" FontSize="12" />
            </StackPanel>
            <Button Grid.Column="1" Content="Clear" Command="{Binding ClearCwDecodedTextCommand}" VerticalAlignment="Top" />
          </Grid>
          <TextBox Grid.Row="1" Text="{Binding CwDecodedText}" Classes="monospace" AcceptsReturn="True" IsReadOnly="True" TextWrapping="Wrap" FontSize="17" Padding="12" />
        </Grid>
        <Border Grid.Column="1" BorderBrush="#202126" BorderThickness="1,0,0,0" Padding="16,0,0,0">
          <controls:ContactLogPanel UseRigCommand="{Binding UseRigForCwLongwaveLogCommand}" />
        </Border>
      </Grid>
      <StackPanel Grid.Row="2" Spacing="8">
        <WrapPanel>
          <Button Content="CQ" Command="{Binding SendCwMacroCommand}" CommandParameter="CQ" Margin="0,0,6,4" />
          <Button Content="DE" Command="{Binding SendCwMacroCommand}" CommandParameter="DE" Margin="0,0,6,4" />
          <Button Content="599" Command="{Binding SendCwMacroCommand}" CommandParameter="RST" Margin="0,0,6,4" />
          <Button Content="TU" Command="{Binding SendCwMacroCommand}" CommandParameter="TU" Margin="0,0,6,4" />
          <Button Content="73" Command="{Binding SendCwMacroCommand}" CommandParameter="73" Margin="0,0,6,4" />
          <Button Content="POTA" Command="{Binding SendCwMacroCommand}" CommandParameter="POTA" Margin="0,0,16,4" />
          <TextBlock Text="{Binding CwTxStatus}" Foreground="#A8A8AE" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="400" />
        </WrapPanel>
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <TextBox Text="{Binding CwSendText}" Watermark="CW text" AcceptsReturn="True" Height="56" TextWrapping="Wrap" />
          <Button Grid.Column="1" Content="Send" Command="{Binding QueueCwSendTextCommand}" VerticalAlignment="Center" />
          <Button Grid.Column="2" Content="Stop TX" Command="{Binding StopCwSendCommand}" VerticalAlignment="Center" BorderBrush="#7D4545" />
        </Grid>
      </StackPanel>
      <Expander Grid.Row="3" Header="Decoder settings / Macro staging" HorizontalContentAlignment="Stretch">
        <ScrollViewer MaxHeight="210" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="8">
            <WrapPanel>
              <Button Content="Load CQ" Command="{Binding LoadCwMacroCommand}" CommandParameter="CQ" Margin="0,0,6,4" />
              <Button Content="Load DE" Command="{Binding LoadCwMacroCommand}" CommandParameter="DE" Margin="0,0,6,4" />
              <Button Content="Load 599" Command="{Binding LoadCwMacroCommand}" CommandParameter="RST" Margin="0,0,6,4" />
              <Button Content="Load TU" Command="{Binding LoadCwMacroCommand}" CommandParameter="TU" Margin="0,0,6,4" />
              <Button Content="Load 73" Command="{Binding LoadCwMacroCommand}" CommandParameter="73" Margin="0,0,6,4" />
              <Button Content="Load POTA" Command="{Binding LoadCwMacroCommand}" CommandParameter="POTA" Margin="0,0,6,4" />
            </WrapPanel>
            <TextBlock Text="{Binding CwEstimatedPitchDisplay, StringFormat=Estimated pitch: {0}}" Foreground="#A8A8AE" />
            <TextBlock Text="{Binding CwEstimatedWpmDisplay, StringFormat=Estimated speed: {0}}" Foreground="#A8A8AE" />
            <TextBlock Text="{Binding CwDecoderConfidenceDisplay, StringFormat=Confidence: {0}}" Foreground="#A8A8AE" />
      <Border Classes="panel">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="12">
            <TextBlock Text="Receive Shaping" Classes="sectionTitle" />

            <Border Classes="section">
              <StackPanel Spacing="8">
                <TextBlock Text="Engine" Classes="sectionTitle" />
                <Grid ColumnDefinitions="92,*" ColumnSpacing="10">
                  <TextBlock Grid.Column="0" Text="Profile" Classes="fieldLabel" />
                  <Border Grid.Column="1" Background="#050608" BorderBrush="#292B31" BorderThickness="1" CornerRadius="3" Padding="10,5">
                    <TextBlock Text="{Binding CwDecoderProfile}" Classes="fieldValue" VerticalAlignment="Center" />
                  </Border>
                </Grid>
                <Grid ColumnDefinitions="92,*" ColumnSpacing="10">
                  <TextBlock Grid.Column="0" Text="Worker" Classes="fieldLabel" />
                  <TextBlock Grid.Column="1" Text="{Binding CwDecoderWorker}" Classes="fieldValue" TextWrapping="Wrap" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Classes="section">
              <StackPanel Spacing="8">
                <TextBlock Text="Tone And Filter" Classes="sectionTitle" />
                <Grid ColumnDefinitions="92,130,Auto" ColumnSpacing="10">
                  <TextBlock Grid.Column="0" Text="Pitch" Classes="fieldLabel" />
                  <NumericUpDown Grid.Column="1" Minimum="300" Maximum="1200" Increment="10" Value="{Binding CwPitchHz}" FormatString="F0" Width="120" />
                  <TextBlock Grid.Column="2" Text="Hz" Classes="fieldValue" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="92,130,Auto" ColumnSpacing="10">
                  <TextBlock Grid.Column="0" Text="Bandwidth" Classes="fieldLabel" />
                  <NumericUpDown Grid.Column="1" Minimum="40" Maximum="600" Increment="10" Value="{Binding CwBandwidthHz}" FormatString="F0" Width="120" />
                  <TextBlock Grid.Column="2" Text="Hz" Classes="fieldValue" VerticalAlignment="Center" />
                </Grid>
                <CheckBox Content="Matched filter" IsChecked="{Binding CwMatchedFilterEnabled}" />
                <TextBlock Text=""
                           Foreground="#8E97AC"
                           TextWrapping="Wrap"
                           FontSize="11" />
              </StackPanel>
            </Border>

            <Border Classes="section">
              <StackPanel Spacing="8">
                <TextBlock Text="Tracking" Classes="sectionTitle" />
                <CheckBox Content="Auto find tone" IsChecked="{Binding CwAutoToneSearchEnabled}" />
                <CheckBox Content="AFC" IsChecked="{Binding CwAfcEnabled}" />
                <Grid ColumnDefinitions="92,130,Auto" ColumnSpacing="10">
                  <TextBlock Grid.Column="0" Text="Search span" Classes="fieldLabel" />
                  <NumericUpDown Grid.Column="1" Minimum="50" Maximum="800" Increment="10" Value="{Binding CwToneSearchSpanHz}" FormatString="F0" Width="120" />
                  <TextBlock Grid.Column="2" Text="Hz" Classes="fieldValue" VerticalAlignment="Center" />
                </Grid>
                <CheckBox Content="Track WPM" IsChecked="{Binding CwTrackingEnabled}" />
                <Grid ColumnDefinitions="92,130,Auto" ColumnSpacing="10">
                  <TextBlock Grid.Column="0" Text="WPM range" Classes="fieldLabel" />
                  <NumericUpDown Grid.Column="1" Minimum="1" Maximum="30" Increment="1" Value="{Binding CwTrackingRangeWpm}" FormatString="F0" Width="120" />
                  <TextBlock Grid.Column="2" Text="WPM" Classes="fieldValue" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="92,*" ColumnSpacing="10">
                  <TextBlock Grid.Column="0" Text="Limits" Foreground="#7F879B" VerticalAlignment="Top" Margin="0,6,0,0" />
                  <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="6">
                    <Grid Grid.Row="0" ColumnDefinitions="64,*" ColumnSpacing="8">
                      <TextBlock Grid.Column="0" Text="Min WPM" Foreground="#AAB1C7" VerticalAlignment="Center" />
                      <NumericUpDown Grid.Column="1" Minimum="5" Maximum="60" Increment="1" Value="{Binding CwLowerWpmLimit}" FormatString="F0" HorizontalAlignment="Stretch" />
                    </Grid>
                    <Grid Grid.Row="1" ColumnDefinitions="64,*" ColumnSpacing="8">
                      <TextBlock Grid.Column="0" Text="Max WPM" Foreground="#AAB1C7" VerticalAlignment="Center" />
                      <NumericUpDown Grid.Column="1" Minimum="6" Maximum="80" Increment="1" Value="{Binding CwUpperWpmLimit}" FormatString="F0" HorizontalAlignment="Stretch" />
                    </Grid>
                  </Grid>
                </Grid>
              </StackPanel>
            </Border>

            <Border Classes="section">
              <StackPanel Spacing="8">
                <TextBlock Text="Decode Behavior" Classes="sectionTitle" />
                <Grid ColumnDefinitions="92,*" ColumnSpacing="10">
                  <TextBlock Grid.Column="0" Text="Attack" Foreground="#7F879B" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding CwAttackOptions}" SelectedItem="{Binding CwSelectedAttack}" />
                </Grid>
                <Grid ColumnDefinitions="92,*" ColumnSpacing="10">
                  <TextBlock Grid.Column="0" Text="Decay" Foreground="#7F879B" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding CwDecayOptions}" SelectedItem="{Binding CwSelectedDecay}" />
                </Grid>
                <Grid ColumnDefinitions="92,*" ColumnSpacing="10">
                  <TextBlock Grid.Column="0" Text="Squelch" Foreground="#7F879B" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding CwSquelchOptions}" SelectedItem="{Binding CwSelectedSquelch}" />
                </Grid>
                <Grid ColumnDefinitions="92,*" ColumnSpacing="10">
                  <TextBlock Grid.Column="0" Text="Spacing" Foreground="#7F879B" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding CwSpacingOptions}" SelectedItem="{Binding CwSelectedSpacing}" />
                </Grid>
                <Grid ColumnDefinitions="92,*" ColumnSpacing="10">
                  <TextBlock Grid.Column="0" Text="Bad code" Foreground="#7F879B" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding CwNoiseCharacterOptions}" SelectedItem="{Binding CwSelectedNoiseCharacter}" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>


          </StackPanel>
        </ScrollViewer>
      </Expander>
    </Grid>
  </controls:OperatingWorkspace>
</Window>
